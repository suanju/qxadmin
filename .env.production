# 应用基础配置
NUXT_ADMIN_AUTH_SECRET=change-me-in-production-at-least-32-chars
NUXT_API_URL=https://admin.example.com

# MySQL 连接配置
TABLE_PREFIX=ta_
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=qxadmin

# 生产初始化种子账号默认关闭；首次初始化时通过系统环境临时传入 ADMIN_INIT_PASSWORD
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
ADMIN_INIT_DISPLAY_NAME=超级管理员
ADMIN_INIT_FORCE_RESET=false

# 后台登录与 RBAC
ADMIN_AUTH_COOKIE_SECURE=true
ADMIN_RBAC_ENFORCE=true
ADMIN_STRICT_ROLE_MODE=false

# 日志
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_FILE_SIZE_MB=50
LOG_RETENTION_DAYS=30
LOG_ARCHIVE_AFTER_DAYS=7
