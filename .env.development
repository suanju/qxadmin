# 应用基础配置
NUXT_ADMIN_AUTH_SECRET=qxadmin_development_secret_please_rotate_32
NUXT_API_URL=http://localhost:3000

# MySQL 连接配置
TABLE_PREFIX=ta_
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=qxadmin

# 本地初始化种子账号，仅供 scripts/init_admin_core_db.mjs 使用
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123456
ADMIN_INIT_DISPLAY_NAME=超级管理员
ADMIN_INIT_FORCE_RESET=false

# 后台登录与 RBAC
ADMIN_AUTH_COOKIE_SECURE=false
ADMIN_RBAC_ENFORCE=false
ADMIN_STRICT_ROLE_MODE=false

# 日志
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_FILE_SIZE_MB=50
LOG_RETENTION_DAYS=30
LOG_ARCHIVE_AFTER_DAYS=7
